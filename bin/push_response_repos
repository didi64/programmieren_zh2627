#!/usr/bin/env bash

set -euo pipefail

REPO_ROOT="/home/studi/work/studis"
pushd "$REPO_ROOT"

token=$(cat .token)
REPO_URL="https://${token}@github.com/dpro-prog2425zh"

mapfile -t  repos < repo_names.txt
for repo_prefix in "${repos[@]}"; do
	repo="${repo_prefix}_response"
	if [ ! -d "$repo" ]; then
		echo "${repo} does not exists, skipping"
		continue
	fi
	
	echo "pushing repo ${repo}"
	git -C "${REPO_ROOT}/${repo}" add -A
	git -C "${REPO_ROOT}/${repo}" commit -m "$(date)" || true
	git -C "${REPO_ROOT}/${repo}" push "${REPO_URL}/${repo}"
	
done
popd