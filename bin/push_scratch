#!/usr/bin/env bash

set -euox pipefail

token=$(cat /home/studi/work/.token_didi64)
REPO_URL="https://${token}@github.com/didi64/programmieren_zh2627.git"

repo="/home/studi/work/.src"
push_dir="notebooks/scratch"

rm -rf "${repo}/${push_dir}"/.*
rm -rf "${repo}/${push_dir}/__pycache__"

echo "pushing scratch"
git -C "${repo}" add -A
git -C "${repo}" commit -m "$(date)" || true
git -C "${repo}" push "${REPO_URL}"

